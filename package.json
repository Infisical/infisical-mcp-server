{
  "name": "@infisical/mcp",
  "version": "0.0.25",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "files": [
    "dist",
    "package.json",
    "npm-shrinkwrap.json",
    "sbom.cdx.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Infisical/infisical-mcp-server"
  },
  "author": "Infisical Inc, <daniel@infisical.com>",
  "keywords": [
    "infisical",
    "open-source",
    "sdk",
    "typescript",
    "mcp",
    "mcp-server",
    "secrets-management",
    "secrets",
    "secrets-manager"
  ],
  "description": "Official Infisical MCP Server",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsup src/index.ts --out-dir dist --format cjs --tsconfig tsconfig.json --no-splitting",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test --test-timeout=30000 test/*.test.js"
  },

  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "axios": "1.20.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}
